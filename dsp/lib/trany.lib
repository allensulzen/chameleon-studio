// PORTED by tools/port/gx-port.py from guitarix trunk/src/LV2/faust/trany.lib (GPL-2.0-or-later).
// C++ lookup tables replaced by pure Faust tables from gx_tables.lib.

import("stdfaust.lib");

gxt = library("gx_tables.lib");

// simple triode circuit emulation
Ftrany = gxt.Ftrany;
Rtrany = gxt.Rtrany;
TB_KT88_68k = gxt.TRANY_TB_KT88_68k;
TB_KT88_250k = gxt.TRANY_TB_KT88_250k;
TB_7199P_68k = gxt.TRANY_TB_7199P_68k;
TB_7199P_250k = gxt.TRANY_TB_7199P_250k;
TB_SVEL34_68k = gxt.TRANY_TB_SVEL34_68k;
TB_SVEL34_250k = gxt.TRANY_TB_SVEL34_250k;
tranystageF(tb,vplus,divider,fck,Rk,Vk0) = anti_aliase : trany : fi.dcblockerat(1.0) with {
    anti_aliase = fi.lowpass(3,ma.SR/2.1);
    Rp = 100.0e3;
    VkC = Vk0 * (Rp + Rtrany(tb)) / Rk;
    Vp = -(Vk0) : Ftrany(tb);
    tranyVp = Vp <: +(VkC - vplus);
    trany(x) = x : (+ : (tranyVp)) ~ (x*Rk/(Rp + Rtrany(tb))) : /(divider);
};

tranystage(tb,fck,Rk,Vk0)  = tranystageF(tb,250.0,40.0,fck,Rk,Vk0);
