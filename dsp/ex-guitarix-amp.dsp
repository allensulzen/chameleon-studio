declare name "Guitarix Lite Amp";
declare description "Self-contained guitarix example: TS9 table clipper into 3x 12AX7 stages, JCM2000 tone stack and cabinet EQ";
declare author "Guitarix project (Hermann Meyer, James Warden, Andreas Degert, Pete Shorthose), adapted by GRAME";
declare license "GPL-2.0-or-later";
declare source "grame-cncm/faust/examples/misc/guitarix.dsp";
declare category "guitar";
declare family "amp";
import("stdfaust.lib");
tu = library("tubes.lib");
ts = library("tonestacks.lib");

drive  = hslider("[0] TS Drive", 0.5, 0, 1, 0.01);
tsTone = hslider("[1] TS Tone[unit:Hz][scale:log]", 400, 100, 1000, 1);
tsLvl  = hslider("[2] TS Level[unit:dB]", 0, -20, 12, 0.1) : ba.db2linear : si.smoo;
pre    = hslider("[3] Pregain[unit:dB]", 3, -20, 30, 0.1) : ba.db2linear : si.smoo;
gain   = hslider("[4] Gain[unit:dB]", 0, -20, 30, 0.1) : ba.db2linear : si.smoo;
treble = hslider("[5] Treble", 0.5, 0, 1, 0.01) : si.smoo;
middle = hslider("[6] Middle", 0.5, 0, 1, 0.01) : si.smoo;
bass   = hslider("[7] Bass", 0.5, 0, 1, 0.01) : si.smoo;
cabmix = hslider("[8] Cab Mix", 1, 0, 1, 0.01) : si.smoo;
cab    = hslider("[9] Cab Level[unit:dB]", -10, -30, 20, 0.1) : ba.db2linear : si.smoo;

// ---- TS9 nonlinearity table (generated by guitarix tools/ts9sim.py) ----
nonlininterpolation(table, low, high, step, size, x) = ts9(low, step, size, table, x), inverse(x) : ccopysign;
ts9(low, step, size, table, x) = interpolation(table, getCoef(low, step, size, x), nonlinindex(low, step, x) : boundIndex(size));
nonlinindex(low, step, x) = (abs(x)/(3.0+abs(x))-low)*step;
getCoef(low, step, size, x) = boundFactor(size, nonlinindex(low, step, x), nonlinindex(low, step, x) : boundIndex(size));
boundIndex(size, index) = int(max(0, min(index, size-1)));
boundFactor(size, index, bindex) = index - bindex : max(0) : min(1);
interpolation(table, coef, index) = table, index : rdtable, (table, index+1 : rdtable) : (_, _ : it.interpolate_linear(coef));
inverse(x) = -x;
ccopysign(x, s) = abs(x) * ma.signum(s) + (s == 0) * x;
ts9comp = nonlininterpolation(ts9table, low, high, step, size)
with {
    low = 0.0; high = 0.970874; step = 101.97; size = 99;
    ts9table = waveform{0.0, -0.0296990148227, -0.0599780676992, -0.0908231643281, -0.122163239629, -0.15376009788, -0.184938007182, -0.214177260107, -0.239335434213, -0.259232575019, -0.274433909887, -0.286183308354, -0.29553854444, -0.303222323477, -0.309706249977, -0.315301338712, -0.320218440785, -0.324604982281, -0.328567120703, -0.332183356975, -0.335513124719, -0.33860236542, -0.34148724693, -0.344196707008, -0.346754233717, -0.34917913798, -0.351487480543, -0.35369275887, -0.355806424152, -0.357838275995, -0.359796767655, -0.361689244919, -0.363522135105, -0.365301098113, -0.367031148289, -0.368716753588, -0.370361916943, -0.371970243537, -0.373544996828, -0.375089145544, -0.376605403346, -0.378096262548, -0.379564022938, -0.381010816596, -0.382438629377, -0.383849319643, -0.385244634694, -0.386626225283, -0.387995658543, -0.389354429565, -0.39070397188, -0.392045667012, -0.393380853288, -0.39471083403, -0.396036885269, -0.397360263098, -0.398682210753, -0.400003965547, -0.401326765733, -0.402651857394, -0.403980501471, -0.405313980999, -0.406653608692, -0.40800073496, -0.409356756504, -0.410723125631, -0.412101360439, -0.413493056085, -0.414899897347, -0.416323672745, -0.417766290556, -0.419229797097, -0.420716397759, -0.422228481377, -0.423768648654, -0.425339745558, -0.426944902828, -0.428587583057, -0.430271637224, -0.432001373102, -0.433781638746, -0.435617925286, -0.437516494692, -0.439484540257, -0.441530390423, -0.443663770898, -0.445896146322, -0.448241172434, -0.450715304661, -0.453338632988, -0.45613605235, -0.45913894467, -0.46238766699, -0.465935359011, -0.469854010456, -0.474244617411, -0.479255257451, -0.48511588606, -0.492212726244, -0.501272723631};
};
ts9sim = ts9nonlin : fi.lowpass(1, tsTone) : *(tsLvl)
with {
    R1 = 4700; R2 = 51000+500000*drive; C = 0.047*1e-6;
    a1 = (R1+R2)*C*2*ma.SR; a2 = R1*C*2*ma.SR;
    B0 = (1+a1)/(1+a2); B1 = (1-a1)/(1+a2); A1 = (1-a2)/(1+a2);
    X2 = fi.tf1(B0, B1, A1);
    ts9nonlin = _ <: _, (X2, _ : - : ts9comp) : - :> _;
};
stage1 = tu.T1_12AX7 : *(pre) : fi.lowpass(1, 6531.0) : tu.T2_12AX7 : *(pre);
stage2 = fi.lowpass(1, 6531.0) : tu.T3_12AX7 : *(gain);
cabinet = _ <: *(1-cabmix), (*(cabmix) : fi.conv((0.000488281, -0.0020752, 0.000561523, -0.00231934, 0.000634766, -0.00247803, 0.000512695, -0.00247803, 0.000146484, -0.00219727, -0.000622559, -0.00145264, -0.00202637, -2.44141e-05, -0.00438232, 0.00247803, -0.00822754, 0.00706787, -0.0159546, 0.0202148, -0.0471558, 0.0953003, -0.208582, 0.312427, 0.75, -0.26803, 0.399963, 0.200696, -0.146655, -0.29303, -0.222168, -0.113098, 0.0267334, 0.0312134, 0.164685, 0.0443481, 0.186621, 0.0540039, 0.123303, 0.0805054, 0.0739868, 0.0591797, 0.0661743, 0.0400391, 0.0429932, 0.0339844, 0.0320557, 0.02323, 0.0217285, 0.0182007, 0.0157227, 0.0130005, 0.0103882, 0.00942383, 0.00718994, 0.0067749, 0.00458984, 0.00455322, 0.00272217, 0.00294189, 0.00140381, 0.00170898, 0.000402832, 0.000720215, -0.000354004, -2.44141e-05, -0.000915527, -0.000610352, -0.00134277, -0.0010498, -0.00166016, -0.0013916, -0.0019043, -0.00166016, -0.0020874, -0.00187988, -0.00224609, -0.00203857, -0.00235596, -0.00217285, -0.0024292, -0.0022583, -0.00247803, -0.00233154, -0.00252686, -0.00238037, -0.00256348, -0.0024292, 0.75, -0.00246582, -0.0026001, -0.00247803, -0.0026001, -0.00249023, -0.0026001, -0.00250244, -0.0026001, -0.00251465, -0.0026001, -0.00251465, -0.0026001, -0.00251465, -0.0026001, -0.00252686, -0.00258789, -0.00252686, -0.00258789, -0.00251465, -0.00257568, -0.00251465, -0.00256348, -0.00251465, -0.00256348, -0.00251465, -0.00256348, -0.00251465, -0.00256348, -0.00251465, -0.00256348, -0.00251465, -0.00256348, -0.00252686, -0.00256348, -0.00252686, -0.00255127, -0.00252686, -0.00255127, -0.00252686, -0.00255127, -0.00252686, -0.00255127, -0.00252686, -0.00256348))) :> *(cab);
process = ts9sim : stage1 : stage2 : ts.jcm2000(treble, middle, bass) : cabinet;
